# "production" makes the server also serve the built client (client/dist)
# and enables secure/cross-site session cookie settings — see README's
# Deployment section. Leave unset for local dev.
NODE_ENV=

PORT=4000

# Where the client app runs; the OAuth callback redirects here after login,
# and this is the allowed CORS origin for session-cookie requests.
# In production (single-service deploy), set this to your deployed URL,
# e.g. https://your-app.onrender.com — see README's Deployment section.
CLIENT_URL=http://localhost:5173

# Salesforce External Client App (Web Server OAuth Flow) credentials.
CLIENT_ID=
CLIENT_SECRET=
# Must exactly match a "Callback URL" configured on the External Client App.
REDIRECT_URI=http://localhost:4000/auth/callback
# https://login.salesforce.com for production/dev orgs, https://test.salesforce.com for sandboxes.
SF_LOGIN_URL=https://login.salesforce.com

# Random string used to sign the session cookie, e.g: openssl rand -hex 32
SESSION_SECRET=
